@inject Database db;
@inject NavigationManager nm;
@inject IJSRuntime js;
@inject EventHookGlobal eh;

<ListPage 
    PageTitle="Sessions"
    PageNumber="PageNumber"
    DB="db"
    PagePath="/Administration/Sessions"
    From="[Security.Sessions]"
    InitialSortColumnAndDirection="-1"
    VisibleRows='new List<string>() { "[SessionID]", "[SessionTime]", "[SessionIP]", "[SessionIPVersion]" }'
    VisibleRowsTitles='new List<string>() { "SessionID", "Session Time", "IP Address", "IP Version" }'
/>

@code {
    [Parameter]
    public int PageNumber { get; set; }
    [Parameter]
    public string SessionID { get; set; }
}