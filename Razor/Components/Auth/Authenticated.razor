@inject Services.User User
@inject EventHookScoped EHS

@if (AssignedRenderMode == RenderMode.InteractiveServer && IsAuthenticated())
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    [Parameter]
    public bool Invert { get; set; } = false;
    private bool IsAuthenticated()
    {
        bool ret = false;
        if (User.Session.UserID != Guid.Empty) ret = true;
        if (Invert) ret = !ret;
        return ret;
    }
    protected override void OnParametersSet()
    {
        EHS.LoginLogoutStatusChanged += OnLoginLogoutStatusChange;
        base.OnParametersSet();
    }
    private void OnLoginLogoutStatusChange(object o, EventArgs args)
    {
        InvokeAsync(() => {
            StateHasChanged();
        });
    }
}