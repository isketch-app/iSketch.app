@inject Self Self
@inject EventHookScoped EHS

@if (AssignedRenderMode == RenderMode.InteractiveServer && IsAuthorized())
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    [Parameter]
    public Access.Permission Permission { get; set; }
    [Parameter]
    public bool Invert { get; set; } = false;
    private bool IsAuthorized()
    {
        bool ret = Self.Permissions.Contains(Permission);
        if (Invert) ret = !ret;
        return ret;
    }
    protected override void OnParametersSet()
    {
        EHS.LoginLogoutStatusChanged += OnLoginLogoutStatusChange;
        base.OnParametersSet();
    }
    private void OnLoginLogoutStatusChange(object o, EventArgs args)
    {
        InvokeAsync(() => {
            StateHasChanged();
        });
    }
}