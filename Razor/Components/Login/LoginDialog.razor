@using System.Net.Mail
@inject Self Self
@inject NavigationManager nm
@inject Services.Session session
@inject EventHookScoped ehs

@if (AssignedRenderMode == RenderMode.InteractiveServer && Self.Session.UserID == Guid.Empty)
{
    <Dialog AllowBreakOut="false" Icon="@(HeaderIcons[(int)CurrentStage])" Header="@(Headers[(int)CurrentStage])" @ref="Dialog">
        <Warning Message="@Warning" />
        @if (CurrentStage == Stage.SelectAnIDP)
        {
            <div class="px-300">
                <div class="logo"></div>
                <h3>Ready to sketch?</h3>
                <h4>Select an option to continue with:</h4>
                <div class="idp-buttons">
                    @foreach (OpenID.idP idP in OpenID.GetIDPs())
                    {
                        <CButton IconURL='@("/_Photo/idP-icon/" + idP.IdpID.ToString())' Emphasis="CButton.EmphasisStyles.Medium" OnClick='() => { nm.NavigateTo(idP.GetRequestURI(session));   }'>@idP.DisplayName</CButton>
                    }
                    <CButton Icon="account_circle" Emphasis="CButton.EmphasisStyles.Medium" OnClick="() => CurrentStage = Stage.ISSignIn">Username / Password</CButton>
                </div>
            </div>
            <DialogButtonContainer SpaceEvenly="true">
                <CButton Icon="contract" Emphasis="CButton.EmphasisStyles.Low" OnClick="() => CurrentStage = Stage.Policies">Policies</CButton>
                <CButton Icon="assignment_ind" Emphasis="CButton.EmphasisStyles.Low" OnClick="() => CurrentStage = Stage.ISSignGuest">Guest</CButton>
                <CButton Icon="eyeglasses_2" Emphasis="CButton.EmphasisStyles.Low" OnClick="() => Dialog.FadeOut()">Viewer</CButton>
            </DialogButtonContainer>
        }
        @if (CurrentStage == Stage.ISSignIn)
        {
            <div class="px-300">
                <div class="input"><CText AutoFocus="true" FocusOnEnter="password" Icon="account_circle" Label="User Name" Value="@UserName" ValueChanged="(v) => UserName = v"></CText></div>
                <div class="input"><CText Name="password" ClickOnEnter="signin" Icon="password_2" Type="password" Label="Password" Value="@Password" ValueChanged="(v) => Password = v"></CText></div>
            </div>
            <DialogButtonContainer SpaceEvenly="true">
                <CButton Icon="arrow_back" Emphasis="CButton.EmphasisStyles.Low" OnClick="() => CurrentStage = Stage.SelectAnIDP">Back</CButton>
                <CButton Icon="person_edit" Emphasis="CButton.EmphasisStyles.Low" OnClick="() => CurrentStage = Stage.ISSignUp">Sign up</CButton>
                <CButton Name="signin" Icon="check" Emphasis="CButton.EmphasisStyles.Low" OnClick="ISSignIn">Sign in</CButton>
            </DialogButtonContainer>
        }
        @if (CurrentStage == Stage.ISSignUp)
        {
            <div class="px-300">
                <div class="input"><CText FocusOnEnter="password" AutoFocus="true" Icon="account_circle" Label="User Name" ValueChanged="(v) => UserName = v"></CText></div>
                <div class="input"><CText FocusOnEnter="confirm" Name="password" Icon="password_2" Type="password" Label="Password" ValueChanged="(v) => Password = v"></CText></div>
                <div class="input"><CText FocusOnEnter="email" Name="confirm" Icon="password_2" Type="password" Label="Password (confirm)" ValueChanged="(v) => Password2 = v"></CText></div>
                <div class="input"><CText ClickOnEnter="signup" Name="email" Icon="alternate_email" Type="email" Label="Recovery Email (optional)" ValueChanged="(v) => Email = v"></CText></div>
            </div>
            <DialogButtonContainer>
                <CButton Icon="arrow_back" Emphasis="CButton.EmphasisStyles.Low" OnClick="() => CurrentStage = Stage.ISSignIn">Back</CButton>
                <CButton Name="signup" Icon="check" Emphasis="CButton.EmphasisStyles.Low" OnClick="ISSignUp">Sign up</CButton>
            </DialogButtonContainer>
        }
        @if (CurrentStage == Stage.ISSignGuest)
        {
            <div class="px-300">
                <div class="input"><CText ClickOnEnter="continue" AutoFocus="true" Icon="account_circle" Label="User Name" ValueChanged="(v) => UserName = v"></CText></div>
            </div>
            <DialogButtonContainer>
                <CButton Icon="arrow_back" Emphasis="CButton.EmphasisStyles.Low" OnClick="() => CurrentStage = Stage.SelectAnIDP">Back</CButton>
                <CButton Name="continue" Icon="check" Emphasis="CButton.EmphasisStyles.Low" OnClick="ISSignGuest">Continue</CButton>
            </DialogButtonContainer>
        }
        @if (CurrentStage == Stage.Policies)
        {
            <div class="px-300 policies">
                <CButton OnClick='() => { _ = Dialog.FadeOut(); nm.NavigateTo("/TermsOfService"); }' Emphasis="CButton.EmphasisStyles.Low" Icon="contract">Terms of Service</CButton>
                <CButton OnClick='() => { _ = Dialog.FadeOut(); nm.NavigateTo("/Privacy"); }' Emphasis="CButton.EmphasisStyles.Low" Icon="policy">Privacy Policy</CButton>
            </div>
            <DialogButtonContainer>
                <CButton Icon="arrow_back" Emphasis="CButton.EmphasisStyles.Low" OnClick="() => CurrentStage = Stage.SelectAnIDP">Back</CButton>
            </DialogButtonContainer>
        }
    </Dialog>
}

@code {
    override protected void OnInitialized()
    {
        ehs.LoginButtonPressed += LoginButtonPressed;
        base.OnInitialized();
    }
    private Stage rCurrentStage = Stage.SelectAnIDP;
    private Stage CurrentStage
    {
        get
        {
            return rCurrentStage;
        }
        set
        {
            Warning = "";
            rCurrentStage = value;
        }
    }
    private Dialog Dialog;
    private string UserName = "";
    private string Password = "";
    private string Password2 = "";
    private string Email = "";
    private string Warning = "";
    private string[] Headers = new string[]
    {
        "Unknown",
        "",
        "Sign up",
        "Sign in",
        "Choose a user name",
        "Our policies"
    };
    private string[] HeaderIcons = new string[]
    {
        "",
        "",
        "",
        "",
        "",
        ""
    };
    private enum Stage : int
    {
        Unknown = 0,
        SelectAnIDP = 1,
        ISSignUp = 2,
        ISSignIn = 3,
        ISSignGuest = 4,
        Policies = 5
    }
    private async Task ISSignIn()
    {
        Warning = "";
        if (await Task.Run<bool>(() => Self.Logon(UserName, Password)))
        {
            await Dialog.FadeOut();
        }
        else
        {
            Warning = "Sign in failed!";
        }
        UserName = Password = null;
    }
    private async Task ISSignUp()
    {
        Warning = "";
        if (Password == "")
        {
            Warning = "Please enter a password.";
            return;
        }
        if (Password != Password2)
        {
            Warning = "Your passwords do not match.";
            return;
        }
        if (!Classes.User.IsValidUserIDString(UserName))
        {
            Warning = "The user name entered is invalid.";
            return;
        }
        MailAddress mail = null;
        if (Email != "" && !MailAddress.TryCreate(Email, out mail))
        {
            Warning = "You entered an invalid email address.";
            return;
        }
        Guid uid = Classes.User.GetUserID(UserName);
        if (uid != Guid.Empty)
        {
            Classes.User.UserAuthMethodsResult methods = Classes.User.GetUserAuthenticationMethods(uid);
            if (methods.Methods != Classes.User.UserAuthMethods.None)
            {
                Warning = "User Name is already taken.";
                return;
            }
        }
        else
        {
            uid = Classes.User.CreateUser(UserName);
        }
        if (mail != null)
        {
            Classes.User.SetUserProperty(uid, Classes.User.UserProperties.Email, mail.Address);
        }
        await Task.Run<bool>(() => Classes.User.ChangePassword(uid, Password));
        Self.Logon(uid);
        await Dialog.FadeOut();
    }
    private async Task ISSignGuest()
    {
        Warning = "";
        if (!Classes.User.IsValidUserIDString(UserName))
        {
            Warning = "The user name entered is invalid.";
            return;
        }
        Guid uid = Classes.User.GetUserID(UserName);
        if (uid != Guid.Empty)
        {
            Classes.User.UserAuthMethodsResult methods = Classes.User.GetUserAuthenticationMethods(uid);
            if (methods.Methods != Classes.User.UserAuthMethods.None)
            {
                Warning = "User Name is already taken.";
                return;
            }
        }
        else
        {
            uid = Classes.User.CreateUser(UserName);
        }
        Self.Logon(uid);
        await Dialog.FadeOut();
    }
    private void LoginButtonPressed(object o, EventArgs e)
    {
        CurrentStage = Stage.SelectAnIDP;
        if (Dialog != null) _ = Dialog.FadeIn();
        StateHasChanged();
    }
}