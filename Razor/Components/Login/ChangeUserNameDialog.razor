@inject Self Self;
@inject EventHookScoped ehs; 

<Authenticated>
    @if (Self.UserName.ToLower() == Self.Session.UserID.ToString().ToLower())
    {
        <Dialog Icon="signature" AllowBreakOut="false" Header="Choose a user name" @ref="Dialog">
            <Warning Message="@Warning" />
            <div class="px-300">
                <div class="input"><CText Icon="signature" Label="User Name" ValueChanged="(v) => UserName = v"></CText></div>
            </div>
            <DialogButtonContainer SpaceEvenly="false">
                <CButton Icon="logout" Emphasis="CButton.EmphasisStyles.Low" OnClick="Self.Logoff">Sign out</CButton>
                <CButton Icon="check" Emphasis="CButton.EmphasisStyles.Low" OnClick="SetUserName">Continue</CButton>
            </DialogButtonContainer>
        </Dialog>
    }
</Authenticated>

@code {
    public Dialog Dialog;
    public string Warning = "";
    public string UserName = "";
    public async Task SetUserName()
    {
        Warning = "";
        User.SetUserNameResult result = User.SetUserName(Self.Session.UserID, UserName);
        if (result == User.SetUserNameResult.UserNameInvalid)
        {
            Warning = "The name entered is not valid.";
        }
        if (result == User.SetUserNameResult.UserNameAlreadyTaken)
        {
            Warning = "The name entered is already taken.";
        }
        if (result == User.SetUserNameResult.UnknownFailure)
        {
            Warning = "Something went wrong, try a different name.";
        }
        if (result == User.SetUserNameResult.Success)
        {
            await Dialog.FadeOut();
            await Self.ReloadUserData();
            ehs.OnLoginLogoutStatusChanged();
        }
    }
}