<div>
    <CButton Emphasis="Emphasis.Low" OnClick="OnApplyClick" Icon="check">Apply</CButton>
    <CButton Emphasis="Emphasis.Low" OnClick="OnSaveClick" Icon="done_all">Save</CButton>
    <CButton Emphasis="Emphasis.Low" OnClick="OnCancelClick" Icon="close">Done</CButton>
</div>

@code {
    [Parameter]
    public EventCallback<MouseEventArgs> OnApplyClick { get; set; }
    [Parameter]
    public EventCallback<MouseEventArgs> OnSaveClick { get; set; }
    [Parameter]
    public EventCallback<MouseEventArgs> OnCancelClick { get; set; }
}