@inject Services.User User
@inject EventHookScoped EventHookScoped;

<span class="r-menu">
    @if (AssignedRenderMode == RenderMode.InteractiveServer)
    {
        <RightMenuItem FMID="connection">
            <span class="indicator">
                <span class="tx">@Icons.Get("north_east")</span>
                <span class="rx">@Icons.Get("south_west")</span>
            </span>
        </RightMenuItem>
    }
    else
    {
        <RightMenuItem FMID="connection" Icon="cloud_off" />
    }
    <Authenticated>
        @if (User.ProfilePictureID == Guid.Empty)
        {
            <RightMenuItem FMID="user" Icon="person" />
        }
        else
        {
            <RightMenuItem FMID="user">
                <ProfilePicture ProfilePictureID="User.ProfilePictureID" />
            </RightMenuItem>
        }
    </Authenticated>
    <Authenticated Invert="true">
        <RightMenuItem FMID="user" Icon="person" />
    </Authenticated>
    <RightMenuItem FMID="general" Icon="more_vert" />
</span>

<FloaterMenu FMID="user">
    <div class="u-top">
        <div class="u-bg">
            <div class="white-circle"></div>
            <ProfilePicture ProfilePictureID="User.ProfilePictureID" />
        </div>
        <Authenticated>
            <div class="u-name">@@@(User.UserName)</div>
        </Authenticated>
        <Authenticated Invert="true">
            <div class="u-name">iSketch.app</div>
        </Authenticated>
    </div>
    <div fmid class="u-menu">
        <Authenticated>
            <a href="/Account"><CMenuItem Icon="account_circle" Text="My Account" /></a>
            <CMenuItem Icon="logout" Text="Sign out" OnClick="() => User.Logoff()" />
        </Authenticated>
        <Authenticated Invert="true">
            <CMenuItem Icon="login" Text="Sign in / Sign up" OnClick="EventHookScoped.OnLoginButtonPressed" />
        </Authenticated>
    </div>
</FloaterMenu>

<FloaterMenu FMID="general">
    <div fmid>
        <a href="/About"><CMenuItem Icon="info" Text="About iSketch.app" /></a>
        <a href="/Rules"><CMenuItem Icon="gavel" Text="Rules" /></a>
        <a href="/Help"><CMenuItem Icon="help" Text="Help" /></a>
        <hr />
        <a href="/TermsOfService"><CMenuItem Icon="contract" Text="Terms of Service" /></a>
        <a href="/Privacy"><CMenuItem Icon="policy" Text="Privacy Policy" /></a>
    </div>
</FloaterMenu>

<FloaterMenu FMID="connection">
    @if (AssignedRenderMode == RenderMode.InteractiveServer)
    {
        <div fmid>Connected to iSketch.app</div>
    }
    else
    {
        <div fmid>Not connected to iSketch.app.</div>
    }
</FloaterMenu>

@code {
    protected override void OnInitialized()
    {
        EventHookScoped.LoginLogoutStatusChanged += OnProfileStatusChanged;
        EventHookScoped.ProfilePictureIDChanged += OnProfileStatusChanged;
        base.OnInitialized();
    }
    private void OnProfileStatusChanged(object o, EventArgs a)
    {
        InvokeAsync(() => StateHasChanged());
    }
}