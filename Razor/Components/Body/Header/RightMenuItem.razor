<span onclick="iSketchSite.Elements.FloaterMenuF.Toggle(this)" fmid="@FMID" class="rmi-mi">
    @ChildContent
    @if (Icon != null)
    {
        <span class="rmi-icon">@Icons.Get(Icon)</span>
    }
</span>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }
    [Parameter]
    public string Icon { get; set; }
    [Parameter]
    public Guid ProfilePictureID { get; set; }
    [Parameter]
    public string FMID { get; set; }
}