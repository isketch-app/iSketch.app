@page "/_Static/Offline"

<VCenter>
    <div class="icon">@Icons.Get("cloud_off")</div>
    <h1>iSketch.app is not responding.</h1>
    <h3>Attempting to reconnect...</h3>
    <div class="spinner"></div>
</VCenter>

<script>
    var xhr = new XMLHttpRequest();
    xhr.onload = function() {
        if (xhr.responseText === 'Healthy') {
            location.reload();
        }
    };
    setInterval(function() {
        xhr.open('GET', '/_Health', true);
        xhr.send();
    }, 3000);
</script>