@page "/About"
@implements IDisposable
@using System.Reflection
@using System.Timers
@using System.IO

<div class="page">
    <div class="logo"></div>
    <h2>iSketch.app</h2>
    <p>@Description</p>
    <hr />
    <table>
        <tr>
            <td>Version:</td>
            <td>@Helpers.Version</td>
        </tr>
        <tr>
            <td>Author:</td>
            <td>@Author</td>
        </tr>
        <tr>
            <td>Copyright:</td>
            <td>@Copyright</td>
        </tr>
        <tr>
            <td>Repository:</td>
            <td><a target="_blank" href="https://github.com/isketch-app/iSketch.app">GitHub</a></td>
        </tr>
        <tr>
            <td>Commit:</td>
            <td><a target="_blank" href="https://github.com/isketch-app/iSketch.app/commit/@Helpers.Commit">@Helpers.MiniCommit</a></td>
        </tr>
        <tr>
            <td>Powered by .NET:</td>
            <td>@NetVersion</td>
        </tr>
    </table>
    <hr />
    <table>
        <tr>
            <td>Server Time:</td>
            <td>@DateTime.Now.ToString()</td>
        </tr>
        <tr>
            <td>Server Name:</td>
            <td>@ServerName</td>
        </tr>
        <tr>
            <td>OS:</td>
            <td>@OS</td>
        </tr>
    </table>
    <hr />
    <table>
        <tr>
            <td>Load:</td>
            <td>@CpuUsage%</td>
        </tr>
        <tr>
            <td>Memory:</td>
            <td>@(System.Environment.WorkingSet / 1024 / 1024) MB</td>
        </tr>
        <tr>
            <td>Threads:</td>
            <td>@(System.Threading.ThreadPool.ThreadCount)</td>
        </tr>
    </table>
    <hr />
    <p>
        <div onclick="iSketchSite.Reload()">
            <CButton Emphasis="CButton.EmphasisStyles.Low" Icon="refresh">Force Update</CButton>
        </div>
    </p>
</div>

@code {
    private static Assembly Self = Assembly.GetExecutingAssembly();
    private string Description = Self.GetCustomAttribute<AssemblyDescriptionAttribute>().Description;
    private string Author = Self.GetCustomAttribute<AssemblyCompanyAttribute>().Company;
    private string Copyright = Self.GetCustomAttribute<AssemblyCopyrightAttribute>().Copyright;
    private string ServerName = System.Environment.MachineName;
    private string OS = System.Environment.OSVersion.ToString();
    private string NetVersion = System.Environment.Version.ToString();
    private double LastCpuTime = System.Environment.CpuUsage.TotalTime.TotalMilliseconds;
    private uint CpuUsage = 0;
    private Timer Timer = new Timer();
    private uint RefreshInterval = 1000;
    protected override Task OnInitializedAsync()
    {
        Timer.Interval = (DateTime.Now.Millisecond - RefreshInterval) * -1;
        Timer.AutoReset = true;
        Timer.Elapsed += Refresh;
        Timer.Start();
        return base.OnInitializedAsync();
    }
    private void Refresh(object o, ElapsedEventArgs e)
    {
        CpuUsage = (uint)Math.Round(
            ((System.Environment.CpuUsage.TotalTime.TotalMilliseconds - LastCpuTime) / System.Environment.ProcessorCount / RefreshInterval) * 100,
            0
        );
        LastCpuTime = System.Environment.CpuUsage.TotalTime.TotalMilliseconds;
        Timer.Interval = (DateTime.Now.Millisecond - RefreshInterval) * -1;
        InvokeAsync(() => {
            StateHasChanged();
        });
    }
    public void Dispose()
    {
        Timer.Elapsed -= Refresh;
        Timer.Stop();
        Timer.Dispose();
    }
}
