@page "/Administration"

<BPageTitle Icon="dashboard_2_gear" Title="System Administration" />

<div class="group">
    <Card Title="Properties"
          SecondaryText="A list of all server properties."
          Icon="page_info" />

    <Card Title="Words"
          SecondaryText="A list of all the drawable words."
          HREF="/Administration/Words"
          Icon="dictionary" />

    <Card Title="Difficulties"
          SecondaryText="A list of word difficutly definitions."
          HREF="/Administration/Difficulties"
          Icon="balance" />

    <Card Title="Banned Words"
          SecondaryText="A list of banned words."
          HREF="/Administration/BannedWords"
          Icon="do_not_disturb_on" />

    <Card Title="Users"
          SecondaryText="A list of all registered users."
          HREF="/Administration/Users"
          Icon="account_circle" />

    <Card Title="Sessions"
          SecondaryText="A list of live user sessions."
          HREF="/Administration/Sessions"
          Icon="id_card" />

    <Card Title="Banned Users"
          SecondaryText="A list of all banned users."
          Icon="account_circle_off" />

    <Card Title="Profile Pictures"
          SecondaryText="A list of selectable account profile pictures."
          HREF="/Administration/ProfilePictures"
          Icon="sticker" />

    <Card Title="Rooms"
          SecondaryText="A list of all registered rooms."
          Icon="meeting_room" />

</div>