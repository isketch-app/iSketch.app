@inject Database db;
@inject NavigationManager nm;
@inject IJSRuntime js;
@inject EventHookGlobal eh;

<ListPage PageTitle="UserID"
          PageNumber="PageNumber"
          DB="db"
          PagePath="/Administration/Users"
          From="[Security.Users] U LEFT JOIN [Security.OpenID] O ON U.[OpenID.IdpID] = O.IdpID"
          PhotoEndpoints='new List<string>() { "profile-picture", "idP-icon" }'
          PhotoColumns="new List<int>() { 1, 6 }"
          InitialSortColumnAndDirection="-4"
          VisibleRows='new List<string>() { "UserID", "ProfilePictureID", "UserName", "Email", "CreatedTime", "LastLogonTime", "[OpenID.IdpID]", "O.DisplayName" }'
          VisibleRowsTitles='new List<string>() { "UserID", "Profile picture", "User name", "Email", "Created", "Last logon", "IDP icon", "IDP" }' />

@code {
    [Parameter]
    public int PageNumber { get; set; }
    [Parameter]
    public string UserID { get; set; }
}